    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Preparar mesa activa para el pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/mesas",
            "description": "Toma la primera mesa activa y guarda su id y su código QR para usarlos en el pedido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const mesas = pm.response.json().filter(m => m.activa);",
                  "if (mesas.length === 0) { throw new Error('No hay mesas activas'); }",
                  "pm.collectionVariables.set('mesaId', mesas[0].id);",
                  "pm.collectionVariables.set('mesaCodigo', mesas[0].codigo);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear pedido (cliente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoPedido\": \"MESA\",\n  \"mesaCodigo\": \"{{mesaCodigo}}\",\n  \"nombreCliente\": \"Cliente de prueba\",\n  \"telefono\": \"3001234567\",\n  \"observaciones\": \"Sin cebolla\",\n  \"items\": [\n    {\n      \"productoId\": {{productoPedidoId}},\n      \"cantidad\": 2,\n      \"observacion\": \"Bien asada\",\n      \"adicionalIds\": [{{adicionalPedidoId}}]\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/pedidos",
            "description": "Este endpoint es público: el cliente crea el pedido y el servidor calcula precios y total."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Descubre un producto y un adicional válidos para la categoría 1.",
                  "const base = pm.variables.get('baseUrl');",
                  "const auth = 'Basic ' + btoa(pm.variables.get('usuario') + ':' + pm.variables.get('password'));",
                  "pm.sendRequest({ url: base + '/api/productos?categoriaId=1&soloDisponibles=true', header: { Authorization: auth } }, function (err, res) {",
                  "  if (!err && res.code === 200 && res.json().length > 0) {",
                  "    pm.collectionVariables.set('productoPedidoId', res.json()[0].id);",
                  "  }",
                  "  pm.sendRequest({ url: base + '/api/adicionales?categoriaId=1&soloDisponibles=true', header: { Authorization: auth } }, function (e2, r2) {",
                  "    if (!e2 && r2.code === 200 && r2.json().length > 0) {",
                  "      pm.collectionVariables.set('adicionalPedidoId', r2.json()[0].id);",
                  "    }",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const pedido = pm.response.json();",
                  "pm.test('El servidor calculó un total mayor que cero', () => pm.expect(pedido.pedido.total).to.be.above(0));",
                  "pm.collectionVariables.set('pedidoId', pedido.pedido.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar pedidos activos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pedidos"
